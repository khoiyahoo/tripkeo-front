rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ──────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Invitations (collection group) ────────────
    // Required for collectionGroup("invitations") queries (invite link lookup,
    // pending invitations on dashboard). Must be at top level, not nested.
    match /{path=**}/invitations/{invitationId} {
      allow read: if true;
    }

    // ─── Trips ──────────────────────────────────────
    match /trips/{tripId} {
      // Anyone who is a member can read the trip
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // Only authenticated users can create trips
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.memberIds;

      // Owner can update anything (except downgrading their own role); editors can update limited fields
      allow update: if request.auth != null
        && (
          // Existing member with owner/editor role
          (
            request.auth.uid in resource.data.memberIds
            && (
              (
                resource.data.members[request.auth.uid].role == 'owner'
                // Bug 3 fix: Owner cannot change their own role via any update path
                && request.resource.data.members[request.auth.uid].role == 'owner'
              )
              ||
              (
                resource.data.members[request.auth.uid].role in ['editor', 'treasurer']
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['members', 'memberIds', 'updatedAt'])
              )
            )
          )
          // OR: user is accepting an invitation (adding themselves as a new member)
          || (
            !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'memberIds', 'updatedAt'])
            && request.auth.uid in request.resource.data.memberIds
          )
          // OR: non-owner member is leaving the trip (removing themselves)
          || (
            request.auth.uid in resource.data.memberIds
            && resource.data.members[request.auth.uid].role != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'memberIds', 'updatedAt'])
            && !(request.auth.uid in request.resource.data.memberIds)
          )
        );

      // Only owner can delete
      allow delete: if request.auth != null
        && resource.data.members[request.auth.uid].role == 'owner';

      // ─── Activities (subcollection) ───────────────
      match /activities/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role in ['owner', 'editor'];

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner'
            || (
              get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'editor'
              && resource.data.createdBy == request.auth.uid
            )
          );

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner'
            || (
              get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'editor'
              && resource.data.createdBy == request.auth.uid
            )
          );
      }

      // ─── Expenses (subcollection) ─────────────────
      match /expenses/{expenseId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role in ['owner', 'treasurer'];

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role in ['owner', 'treasurer'];

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role in ['owner', 'treasurer'];
      }

      // ─── Invitations (subcollection) ──────────────
      match /invitations/{invitationId} {
        // Anyone can read — user may not be logged in when clicking invite link
        allow read: if true;

        // Only owner can create invitations
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner';

        // Update: owner or the invited user (to accept/decline)
        // Also allow authenticated users accepting share-link invitations (email is empty).
        // Restricted to changing status only, preventing tampering with other fields.
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined']
          && (
            // Owner can update any invitation status
            (
              request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
              && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner'
            )
            // The invited user can accept/decline their own email invitation
            || request.auth.token.email == resource.data.email
            // Any authenticated user can accept/decline a share-link invitation
            || resource.data.email == ''
          );

        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner';
      }

      // ─── Personal Activities (subcollection) ──────
      // Only the activity owner (userId field) can read/write their own entries.
      // They must also be a member of the trip.
      match /personalActivities/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.auth.uid == resource.data.userId;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.auth.uid == request.resource.data.userId;

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.auth.uid == resource.data.userId
          && request.auth.uid == request.resource.data.userId;

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.auth.uid == resource.data.userId;
      }
    }

    // ─── Community Posts ────────────────────────────
    match /communityPosts/{postId} {
      // Anyone can read posts (public)
      allow read: if true;

      // Authenticated users can create posts
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorId;

      // Author can update/delete their own post
      allow update: if request.auth != null
        && (
          request.auth.uid == resource.data.authorId
          // Allow likeCount/commentCount/cloneCount updates (transactions from any authenticated user)
          || (
            request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount', 'commentCount', 'cloneCount'])
          )
        );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.authorId
             || request.auth.uid == get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId);
      }

      // Likes subcollection (doc id = userId)
      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
