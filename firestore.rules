rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ──────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Invitations (collection group) ────────────
    // Required for collectionGroup("invitations") queries (invite link lookup,
    // pending invitations on dashboard). Must be at top level, not nested.
    match /{path=**}/invitations/{invitationId} {
      allow read: if true;
    }

    // ─── Trips ──────────────────────────────────────
    match /trips/{tripId} {
      // Anyone who is a member can read the trip
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // Only authenticated users can create trips
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.memberIds;

      // Owner can update anything; editors can update limited fields
      allow update: if request.auth != null
        && (
          // Existing member with owner/editor role
          (
            request.auth.uid in resource.data.memberIds
            && (
              resource.data.members[request.auth.uid].role == 'owner'
              ||
              (
                resource.data.members[request.auth.uid].role == 'editor'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['members', 'memberIds', 'updatedAt'])
              )
            )
          )
          // OR: user is accepting an invitation (adding themselves as a new member)
          || (
            !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'memberIds', 'updatedAt'])
            && request.auth.uid in request.resource.data.memberIds
          )
          // OR: non-owner member is leaving the trip (removing themselves)
          || (
            request.auth.uid in resource.data.memberIds
            && resource.data.members[request.auth.uid].role != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'memberIds', 'updatedAt'])
            && !(request.auth.uid in request.resource.data.memberIds)
          )
        );

      // Only owner can delete
      allow delete: if request.auth != null
        && resource.data.members[request.auth.uid].role == 'owner';

      // ─── Activities (subcollection) ───────────────
      match /activities/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role in ['owner', 'editor'];

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner'
            || (
              get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'editor'
              && resource.data.createdBy == request.auth.uid
            )
          );

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner'
            || (
              get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'editor'
              && resource.data.createdBy == request.auth.uid
            )
          );
      }

      // ─── Expenses (subcollection) ─────────────────
      match /expenses/{expenseId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role in ['owner', 'editor'];

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner'
            || (
              get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'editor'
              && resource.data.createdBy == request.auth.uid
            )
          );

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner'
            || (
              get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'editor'
              && resource.data.createdBy == request.auth.uid
            )
          );
      }

      // ─── Invitations (subcollection) ──────────────
      match /invitations/{invitationId} {
        // Anyone can read — user may not be logged in when clicking invite link
        allow read: if true;

        // Only owner can create invitations
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner';

        // Update: owner or the invited user (to accept/decline)
        // Also allow authenticated users accepting share-link invitations (email is empty)
        allow update: if request.auth != null
          && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner'
            || request.auth.token.email == resource.data.email
            || resource.data.email == ''
          );

        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'owner';
      }
    }
  }
}
